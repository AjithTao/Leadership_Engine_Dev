# Copy this file to .env and fill in real values.
# Never commit .env or real credentials to the repository.

# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=your_jira_personal_access_token_here

# Confluence Configuration
CONFLUENCE_API_TOKEN=your_confluence_personal_access_token_here

# Atlassian Cloud (used by scripts/fetch_jira.ps1)
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here

# Session encryption (used by backend/services/encryption.py)
SESSION_SECRET_KEY=generate_a_long_random_value_here
