# ============================================
# Session Secret Key (for password encryption)
# ============================================
SESSION_SECRET_KEY=generate_a_long_random_value_here

# ============================================
# Hosted Authentication Configuration
# ============================================
AUTH_MODE=local
APP_ADMIN_USERNAME=falcon-admin
APP_ADMIN_PASSWORD=replace_with_a_long_unique_password
APP_ADMIN_EMAIL=admin@example.com
JWT_SECRET_KEY=generate_another_long_random_value_here

# ============================================
# Jira Service Account (Common Credentials)
# ============================================
# Enter TAO values. Raw tokens are accepted when supplied as hosting secrets.
JIRA_SERVICE_EMAIL=tao-service-account@example.com
JIRA_SERVICE_API_TOKEN=replace_with_tao_jira_token
JIRA_BASE_URL=https://your-tao-jira.example.com
JIRA_BOARD_ID=
# ============================================
# Confluence Service Account (Common Credentials)
# ============================================
# Enter TAO values. Raw tokens are accepted when supplied as hosting secrets.
CONFLUENCE_SERVICE_EMAIL=tao-service-account@example.com
CONFLUENCE_SERVICE_API_TOKEN=replace_with_tao_confluence_token
CONFLUENCE_BASE_URL=https://your-tao-confluence.example.com

# ============================================
# GitHub Service Account (Common Credentials)
# ============================================
# Fine-grained token used by the hosted integration.
GITHUB_SERVICE_TOKEN=replace_with_github_token

# ============================================
# Integration-only hosted mode
# ============================================
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=
OPENAI_EMBEDDINGS_API_KEY=
OPENAI_EMBEDDINGS_API_ENDPOINT=
DATABRICKS_ENABLED=false
EXTRA_CORS_ORIGINS=https://your-frontend.onrender.com

# ============================================
# Setup Instructions:
# ============================================
# 1. Copy this file to .env (remove .template)
# 2. Fill in the TAO Jira, TAO Confluence, and GitHub credentials.
# 3. Set independent SESSION_SECRET_KEY and JWT_SECRET_KEY random values.
# 4. Never commit the populated .env file.


