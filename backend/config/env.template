# ============================================
# Salesforce Integration
# ============================================
# Used for AI-powered ticket categorization.
# Create a Connected App in Salesforce Setup → App Manager.
# Enable OAuth, select scopes: api, refresh_token.
# Append your Security Token to your password (no space):
#   SALESFORCE_PASSWORD=mypasswordSECURITYTOKEN
SALESFORCE_INSTANCE_URL=https://yourcompany.salesforce.com
SALESFORCE_CLIENT_ID=<Consumer Key from Connected App>
SALESFORCE_CLIENT_SECRET=<Consumer Secret from Connected App>
SALESFORCE_USERNAME=service-account@yourcompany.com
SALESFORCE_PASSWORD=<password + security token appended>

